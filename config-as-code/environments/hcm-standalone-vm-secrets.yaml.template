# Secrets for the standalone-VM environment (hcm-standalone-vm.yaml).
#
# Copy to hcm-standalone-vm-secrets.yaml, fill in NEWLY GENERATED values and keep it readable
# only by its owner (chmod 600). Never commit the filled-in file.
# Example generator:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c <length>
#
# Without a .sops.yaml in config-as-code/, the deployer reads this file as plain text.
cluster-configs:
    secrets:
        db:
            # `backbone` for the in-cluster Postgres, `es-cluster` for auth-proxy
            namespace: [ egov, demo, backbone, es-cluster ]
            username: "<db-username>"
            password: "<db-password>"
            flywayUsername: "<same-as-db-username>"
            flywayPassword: "<same-as-db-password>"
        egov-notification-sms:
            username: "<dummy-unless-you-have-an-sms-gateway>"
            password: "<dummy-unless-you-have-an-sms-gateway>"
        project-factory:
            namespace: [ egov ]
            base-secret: "<random-32-chars>"
        minio:
            # In-cluster MinIO root credentials: use the SAME values as egov-filestore below
            accesskey: "<random-20-chars>"
            secretkey: "<random-40-chars>"
        egov-filestore:
            aws-key: "<same-as-minio-accesskey>"
            aws-secret-key: "<same-as-minio-secretkey>"
        egov-location:
            gmapskey: "<dummy-unless-you-have-a-google-maps-key>"
        egov-pg-service:
            axis-merchant-id: "dummy"
            axis-merchant-secret-key: "dummy"
            axis-merchant-user: "dummy"
            axis-merchant-pwd: "dummy"
            axis-merchant-access-code: "dummy"
            payu-merchant-key: "dummy"
            payu-merchant-salt: "dummy"
        pgadmin:
            admin-email: "<admin-email>"
            admin-password: "<random-password>"
            read-email: "<read-only-email>"
            read-password: "<random-password>"
        egov-enc-service:
            # Back these up: data encrypted with them cannot be read without them
            master-password: "<random-32-chars>"
            master-salt: "<random-8-chars>"
            master-initialvector: "<random-12-chars>"
        egov-notification-mail:
            mailsenderusername: "dummy"
            mailsenderpassword: "dummy"
        git-sync:
            # Not used when global.gitSync.ssh is false (public repos over HTTPS); must be non-empty
            namespace: [ egov ]
            ssh: "unused-https-mode"
            known-hosts: "unused-https-mode"
        kibana:
            namespace: es-cluster
            credentials: "<htpasswd line, e.g. output of: htpasswd -nb admin <password>>"
        elasticsearch-master-creds:
            # Also becomes the Elasticsearch `elastic` password (see README, Deploy)
            namespace: [ es-cluster, egov ]
            password: "<random-24-chars>"
